# Data (chỉ giữ cấu trúc thư mục qua .gitkeep, không commit dữ liệu thật)
data/external/*
data/interim/*
data/processed/*
data/raw/*
!data/external/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/raw/.gitkeep

# Models (file model huấn luyện thường nặng, không nên commit)
models/*
!models/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Environment
.env
.venv/
env/
venv/

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
